            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    },
    "Each book keeps its place at the chapter with the same number. The downloads of the old source leave the device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各本は同じ番号の話で位置を保ちます。古いソースのダウンロードは端末から削除されます。"
          }
        }
      }
    },
